# ─────────────────────────────────────────────────────────────
# DM-to-Deal — environment configuration
# Copy to `.env` and fill in. NEVER commit your real .env.
# ─────────────────────────────────────────────────────────────

# The Claude brain (required). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Model + reasoning effort. Defaults are sensible for production.
DM_MODEL=claude-opus-4-7
DM_EFFORT=low                  # low | medium | high | max  (cost vs. quality)
DM_THINKING=disabled           # disabled | adaptive  (adaptive = deeper reasoning, slower/costlier)

# HTTP server
PORT=3000

# Messaging channel: which adapter receives/sends Instagram DMs.
DM_CHANNEL=mock                # mock | manychat
MANYCHAT_API_TOKEN=            # required when DM_CHANNEL=manychat
MANYCHAT_WEBHOOK_SECRET=       # shared secret to verify inbound webhooks

# CRM / memory store: where leads + transcripts live.
DM_STORE=memory                # memory | sheets
GOOGLE_SHEETS_ID=              # required when DM_STORE=sheets
GOOGLE_SERVICE_ACCOUNT_JSON=   # path to service-account credentials json

# Booking
CALENDLY_BOOKING_URL=https://calendly.com/your-handle/strategy-call

# Compliance / account safety (Instagram-safe pacing).
DM_MIN_REPLY_DELAY_SECONDS=120     # never reply faster than this (look human)
DM_MAX_REPLY_DELAY_SECONDS=480
DM_MAX_MESSAGES_PER_DAY=60         # per connected account — stay under Meta limits
