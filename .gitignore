# Dependencies & build output
node_modules/
dist/
*.tsbuildinfo

# Secrets & credentials — NEVER commit these
.env
.env.*
!.env.example
*.key
*.pem
secrets.json
credentials.json
service-account*.json
google-credentials*.json
# Google Cloud's default download name is <project-id>-<hash>.json, which
# doesn't match the patterns above. Catch the project-specific pattern and
# Firebase admin SDK keys explicitly.
dm-to-deal-*.json
*-firebase-adminsdk-*.json
*-service-account-*.json

# OS files
Thumbs.db
.DS_Store
desktop.ini

# Editor
.vscode/
.idea/

# Claude Code — user-local settings (per-developer permissions allowlist)
.claude/settings.local.json

# Real influencer profiles are proprietary voice IP — never commit.
# Only the example template is tracked.
profiles/*.json
!profiles/example.json

# Logs & temp
*.log
npm-debug.log*
_prd_raw.txt
tmp/
coverage/
