{
  "name": "dm-to-deal",
  "version": "0.1.0",
  "description": "An autonomous AI sales agent that captures warm Instagram leads, converses in the influencer's voice, books calls, and tracks revenue.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "simulate": "tsx scripts/simulate-conversation.ts"
  },
  "keywords": [
    "ai",
    "sales-agent",
    "instagram",
    "anthropic",
    "claude",
    "automation"
  ],
  "author": "Meet Kabra",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "express": "^5.1.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
